import "ConfigSave.aadl";

class UITheme {
    method showClassic() {
        let config = new ConfigSave();
        config.setBlue();
        title("ANNYOS CLASSIC CONSOLE");
        print("The active colors are selected by the kernel COLOR command.");
    }

    method showMatrix() {
        let config = new ConfigSave();
        config.setMatrix();
        title("ANNYOS MATRIX CONSOLE");
        print("Use COLOR MATRIX to enable the black and green theme.");
    }
}
